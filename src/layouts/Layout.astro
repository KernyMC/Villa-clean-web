---
import "../styles/global.css";
import { contact } from "../data/site";
import { getSiteImages, urlFor } from "../lib/sanity";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Villa Home Detail — Premium House Cleaning for Austin's Westside Homes",
  description = "Discreet, background-checked residential cleaning for West Lake Hills, Tarrytown, and Barton Creek. Same team every visit, instant online quote.",
} = Astro.props;

// Indexing kill switch — flip to true (and delete the two <meta name="robots">
// lines below along with public/robots.txt's "Disallow: /") when the site is
// ready to go live in search. See CLAUDE.md's "Going live" checklist.
const INDEXING_ENABLED = true;

const siteUrl = "https://villahomedetail.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const siteImages = await getSiteImages();
const ogImage = siteImages?.aboutImage?.asset
  ? urlFor(siteImages.aboutImage).width(1200).height(630).fit("crop").auto("format").url()
  : undefined;

// Service-area business with no public storefront — per Google's structured-data
// guidance for SABs, omit a street `address` rather than publish a placeholder one.
// `areaServed` carries the location signal instead.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Villa Home Detail",
  url: siteUrl,
  image: ogImage || "",
  telephone: contact.phone,
  areaServed: [
    { "@type": "City", name: "Austin", "@id": "https://en.wikipedia.org/wiki/Austin,_Texas" },
    { "@type": "Place", name: "West Lake Hills, TX" },
    { "@type": "Place", name: "Tarrytown, Austin, TX" },
    { "@type": "Place", name: "Barton Creek, Austin, TX" },
  ],
  openingHours: "Mo-Sa 08:00-18:00",
  priceRange: "$$$",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How much does house cleaning cost in West Lake Hills?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Most homes in West Lake Hills run 3,500 to 6,000 square feet. At our recurring bi-weekly rate, that typically prices between $360 and $580 per visit, with the first visit, a full deep clean, quoted separately.",
      },
    },
    {
      "@type": "Question",
      name: "Do I need to be home?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Most clients are away during their visit. We are insured, background-checked, and work from a key or code protocol you set.",
      },
    },
    {
      "@type": "Question",
      name: "Is the team background-checked?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Every member of your care team passes a background check before entering a client home, and the same two people are assigned to your account.",
      },
    },
    {
      "@type": "Question",
      name: "What products do you use?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We use professional-grade, low-VOC products suited to natural stone, hardwood, and high-end finishes.",
      },
    },
    {
      "@type": "Question",
      name: "Can I change my schedule?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Move, skip, or add a visit with 48 hours notice through your account.",
      },
    },
    {
      "@type": "Question",
      name: "What if something is missed?",
      acceptedAnswer: { "@type": "Answer", text: "We return within 24 hours at no charge." },
    },
  ],
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Villa Home Detail",
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  telephone: contact.phone,
  areaServed: ["West Lake Hills, TX", "Tarrytown, Austin, TX", "Barton Creek, Austin, TX"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Villa Home Detail",
  url: siteUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {!INDEXING_ENABLED && (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    )}
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 300'%3E%3Cpolyline points='20,110 150,280 280,110' fill='none' stroke='%233E5245' stroke-width='22'/%3E%3Cpolyline points='80,150 150,40 220,150' fill='none' stroke='%233E5245' stroke-width='22'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..600,0..100&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Villa Home Detail" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#1C2620" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <slot />
    <script>
      const translations: Record<string, string> = {
        "Pricing": "Precios",
        "Areas": "Áreas",
        "About": "Nosotros",
        "Get a Quote": "Obtener cotización",
        "Premium House Cleaning for Austin's Westside Homes": "Limpieza premium para los hogares del oeste de Austin",
        "A discreet, background-checked team maintains your home to the same exacting standard, every visit, so it never becomes something you have to think about.": "Un equipo discreto y verificado mantiene tu hogar con el mismo estándar impecable en cada visita, para que nunca tengas que preocuparte por ello.",
        "Get your free quote in 60 seconds": "Obtén tu cotización gratis en 60 segundos",
        "Background-checked": "Personal verificado",
        "Same team every visit": "El mismo equipo en cada visita",
        "Satisfaction guaranteed": "Satisfacción garantizada",
        "Services": "Servicios",
        "Recurring Care": "Cuidado recurrente",
        "Deep Clean": "Limpieza profunda",
        "Move-In / Move-Out": "Mudanza de entrada / salida",
        "Post-Construction": "Después de construcción",
        "How it works": "Cómo funciona",
        "Tell us about your home": "Cuéntanos sobre tu hogar",
        "We schedule a walkthrough": "Agendamos una visita",
        "Your team takes it from there": "Tu equipo se encarga del resto",
        "What's included": "Qué incluye",
        "Before and after": "Antes y después",
        "Estimate your quote": "Calcula tu cotización",
        "Adjust the details below for an instant estimate. Every home is confirmed with an in-person walkthrough.": "Ajusta los detalles para obtener un estimado instantáneo. Cada hogar se confirma con una visita presencial.",
        "Square footage": "Metros cuadrados",
        "Bedrooms": "Habitaciones",
        "Bathrooms": "Baños",
        "Frequency": "Frecuencia",
        "Weekly": "Semanal",
        "Bi-weekly": "Cada dos semanas",
        "Monthly": "Mensual",
        "One-time": "Una sola vez",
        "Estimated visit price": "Precio estimado por visita",
        "Your first visit is a deep clean, quoted separately.": "La primera visita es una limpieza profunda y se cotiza por separado.",
        "Need another quote? Ask us directly": "¿Necesitas otra cotización? Escríbenos directamente",
        "Lock this quote": "Guardar esta cotización",
        "Quote saved. We will call within one business day to confirm your walkthrough.": "Cotización guardada. Te llamaremos en un día hábil para confirmar tu visita.",
        "Where we work": "Dónde trabajamos",
        "Service areas": "Áreas de servicio",
        "Thoughtful home care for Austin's most distinctive neighborhoods.": "Cuidado detallado para los vecindarios más exclusivos de Austin.",
        "And more areas of Texas": "Y más áreas de Texas",
        "Still have a question?": "¿Todavía tienes preguntas?",
        "Frequently asked": "Preguntas frecuentes",
        "Send us a note and we will get back to you within one business day.": "Envíanos un mensaje y te responderemos en un día hábil.",
        "Contact": "Contacto",
        "Name": "Nombre",
        "Email": "Correo electrónico",
        "Phone": "Teléfono",
        "Message": "Mensaje",
        "Your name": "Tu nombre",
        "How can we help?": "¿Cómo podemos ayudarte?",
        "Send message": "Enviar mensaje",
        "Sending…": "Enviando…",
        "Sent": "Enviado",
        "Please enter your name.": "Por favor ingresa tu nombre.",
        "Please enter your email.": "Por favor ingresa tu correo electrónico.",
        "Please enter a valid email address.": "Por favor ingresa un correo electrónico válido.",
        "Please enter your phone number.": "Por favor ingresa tu número de teléfono.",
        "Please enter a valid 10-digit US phone number.": "Por favor ingresa un número de teléfono de EE. UU. válido de 10 dígitos.",
        "Please tell us how we can help.": "Por favor cuéntanos cómo podemos ayudarte.",
        "What clients say": "Lo que dicen nuestros clientes",
        "Follow us": "Síguenos",
        "Immaculate homes, handled quietly.": "Hogares impecables, atendidos con discreción.",
        "Villa Home Detail": "Villa Home Detail",
        "Get your free quote": "Obtén tu cotización gratis",
        "Austin, Texas": "Austin, Texas",
        "Monday–Saturday": "Lunes–sábado",
        "8:00am – 6:00pm": "8:00 a. m. – 6:00 p. m.",
        "Kitchen": "Cocina",
        "Living Spaces": "Áreas de estar",
      };

      const normalizeText = (value: string) => value.replace(/\s+/g, " ").trim();
      const originalText = new WeakMap<Text, string>();
      const originalAttributes = new WeakMap<HTMLElement, Record<string, string>>();
      const translatableAttributes = ["placeholder", "aria-label", "alt"];

      const translatePage = (language: "en" | "es") => {
        document.documentElement.lang = language;
        document.querySelectorAll<HTMLElement>("[data-language-toggle]").forEach((button) => {
          button.textContent = language === "en" ? "ES" : "EN";
        });

        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        const textNodes: Text[] = [];
        let node: Node | null;
        while ((node = walker.nextNode())) {
          if (node.parentElement && !["SCRIPT", "STYLE"].includes(node.parentElement.tagName)) textNodes.push(node as Text);
        }
        textNodes.forEach((textNode) => {
          if (!originalText.has(textNode)) originalText.set(textNode, textNode.textContent || "");
          const source = originalText.get(textNode) || "";
          const key = normalizeText(source);
          const replacement = language === "es" ? translations[key] : key;
          if (!replacement) return;
          const leading = source.match(/^\s*/)?.[0] || "";
          const trailing = source.match(/\s*$/)?.[0] || "";
          textNode.textContent = `${leading}${replacement}${trailing}`;
        });

        document.querySelectorAll<HTMLElement>("body *").forEach((element) => {
          if (!originalAttributes.has(element)) {
            const saved: Record<string, string> = {};
            translatableAttributes.forEach((attribute) => {
              const value = element.getAttribute(attribute);
              if (value) saved[attribute] = value;
            });
            originalAttributes.set(element, saved);
          }
          const saved = originalAttributes.get(element) || {};
          translatableAttributes.forEach((attribute) => {
            const source = saved[attribute];
            if (!source) return;
            element.setAttribute(attribute, language === "es" ? translations[normalizeText(source)] || source : source);
          });
        });
        localStorage.setItem("villa-language", language);
      };

      document.querySelectorAll<HTMLElement>("[data-language-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const nextLanguage = document.documentElement.lang === "es" ? "en" : "es";
          translatePage(nextLanguage);
        });
      });

      const savedLanguage = localStorage.getItem("villa-language");
      if (savedLanguage === "es") translatePage("es");

      const revealEls = Array.from(document.querySelectorAll("[data-reveal]"));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.12 }
      );
      revealEls.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
