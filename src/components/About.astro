---
import { getSiteImages, urlFor } from "../lib/sanity";

const siteImages = await getSiteImages();
const aboutImageUrl = siteImages?.aboutImage?.asset
  ? urlFor(siteImages.aboutImage).width(900).auto("format").url()
  : undefined;
const aboutImageAlt = siteImages?.aboutImage?.alt || "Founder portrait";
---

<section id="about" data-reveal class="px-5 sm:px-8 lg:px-20 py-18 sm:py-24 lg:py-30 max-w-7xl mx-auto">
  <div class="grid gap-16 items-center" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
    <div
      class:list={["about-photo-shell", { "about-photo-shell--empty": !aboutImageUrl }]}
      style={aboutImageUrl ? undefined : "background: repeating-linear-gradient(135deg, #E8E3D8 0px, #E8E3D8 14px, #F4F1EA 14px, #F4F1EA 28px);"}
    >
      {aboutImageUrl ? (
        <img src={aboutImageUrl} alt={aboutImageAlt} class="about-photo" loading="lazy" />
      ) : (
        <span aria-hidden="true" class="font-mono text-xs text-ink tracking-wide">PHOTOGRAPH — founder portrait</span>
      )}
      <div aria-hidden="true" class="about-photo-fade"></div>
      <div aria-hidden="true" class="about-photo-fade-bottom"></div>
    </div>
    <div>
      <h2 class="font-serif font-serif-opt font-medium text-[clamp(1.8rem,3.5vw,2.6rem)] tracking-[-0.01em] m-0 mb-8">
        About
      </h2>
      <p class="max-w-[36em] text-[17px] text-ink m-0 mb-5">
        Silvana and Alejandro started Villa Home Detail after years of cleaning other people's homes
        for companies that never seemed to notice the difference between one house and the next. They
        kept meeting the same problem: a good team that disappeared after two visits, or a service that
        treated every home the same. Neither respected what was actually being asked, which was trust.
      </p>
      <p class="max-w-[36em] text-[17px] text-ink m-0 mb-8">
        So they built something smaller and more deliberate: the same two-person team in every home,
        every time, usually the two of them. Every visit follows a protocol you set, not one imposed on
        you. That is the whole idea.
      </p>
      <p class="font-serif font-serif-opt italic text-[1.1rem] m-0">— Silvana &amp; Alejandro, Founders, Villa Home Detail</p>
    </div>
  </div>
</section>

<style>
  .about-photo-shell {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-photo-shell--empty {
    aspect-ratio: 4 / 5;
  }

  .about-photo {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(0.96);
  }

  .about-photo-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(18, 17, 14, 0.08) 0%,
      rgba(18, 17, 14, 0.02) 28%,
      rgba(18, 17, 14, 0) 58%
    );
    pointer-events: none;
  }

  .about-photo-fade-bottom {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Only does anything once the shell bleeds past the section's own
       bottom/left edge below — hidden until then so it doesn't wash out
       the tablet/mobile stacked layout. */
    display: none;
  }

  /* Bleed the photo out to the section's own edges (bottom + left) and
     grow it — the right edge stays put so it never encroaches on the
     copy column. Only at the breakpoint where the two-column layout
     actually exists. */
  @media (min-width: 1024px) {
    .about-photo-shell {
      align-self: end;
      width: calc(100% + 160px);
      margin-left: -160px;
      margin-bottom: -120px;
    }

    .about-photo-fade-bottom {
      display: block;
      background: linear-gradient(to top, var(--color-cream) 0%, var(--color-cream) 8%, transparent 45%);
    }
  }
</style>
