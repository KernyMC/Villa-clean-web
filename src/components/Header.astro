---
import Logo from "./Logo.astro";
import { contact } from "../data/site";

const navLinks = [
  { href: "#services", label: "Services" },
  { href: "#faq", label: "Contact" },
  { href: "#areas", label: "Areas" },
  { href: "#about", label: "About" },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-[100] bg-transparent transition-[padding,transform,opacity,background-color,backdrop-filter] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] py-7 data-[scrolled=true]:py-3.5 data-[scrolled=true]:bg-ink/95 data-[scrolled=true]:backdrop-blur-sm data-[hidden=true]:-translate-y-full data-[hidden=true]:opacity-0"
  data-scrolled="false"
  data-hidden="false"
>
  <div class="mx-auto flex min-w-0 max-w-7xl items-center justify-between gap-3 overflow-hidden px-4 sm:gap-6 sm:px-8 lg:px-12">
    <Logo class="h-8 shrink md:h-11 transition-[height] duration-300" stroke="#F4F1EA" textColor="#F4F1EA" subTextColor="rgba(244,241,234,0.6)" />

    <nav aria-label="Primary" class="hidden md:flex gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-cream no-underline text-sm tracking-wide hover:text-brass">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="hidden md:flex items-center gap-5">
      <button type="button" data-language-toggle class="text-cream text-xs font-semibold tracking-[0.14em] hover:text-brass" aria-label="Change language">ES</button>
      <a href={contact.phoneHref} data-magnetic class="header-phone text-cream text-sm no-underline hover:text-brass">
        <span class="header-phone__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"></path>
          </svg>
        </span>
        {contact.phone}
      </a>
      <a
        href="#faq"
        data-glare
        class="bg-brass text-ink no-underline px-5.5 py-3 text-sm tracking-wide rounded-sm"
      >
        Get a Quote
        <span class="glare-sweep" aria-hidden="true"></span>
      </a>
    </div>

    <div class="flex shrink-0 items-center gap-2 md:hidden">
      <button type="button" data-language-toggle class="text-[11px] font-semibold tracking-[0.12em] text-cream" aria-label="Change language">ES</button>
      <a
        href="#faq"
        data-glare
        class="bg-brass text-ink no-underline px-3 py-2.5 text-[12px] tracking-wide rounded-sm"
      >
        Get a Quote
        <span class="glare-sweep" aria-hidden="true"></span>
      </a>
      <button
        type="button"
        id="mobile-nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="w-10 h-10 border border-cream/25 bg-none flex flex-col items-center justify-center gap-1.5 cursor-pointer rounded-sm flex-shrink-0"
      >
        <span class="w-4.5 h-px bg-cream block"></span>
        <span class="w-4.5 h-px bg-cream block"></span>
        <span class="w-4.5 h-px bg-cream block"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-nav"
  class="fixed inset-0 z-[200] bg-ink hidden flex-col items-center justify-center gap-9"
>
  <button
    type="button"
    id="mobile-nav-close"
    aria-label="Close menu"
    class="absolute top-6 right-5 sm:right-8 w-10 h-10 border border-cream/25 bg-none cursor-pointer rounded-sm text-[22px] text-cream"
  >
    &times;
  </button>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class="mobile-nav-link font-serif font-serif-opt text-2xl text-cream no-underline"
    >
      {link.label}
    </a>
  ))}
</div>

<script>
  const header = document.getElementById("site-header");
  let lastScrollY = window.scrollY;
  let scrollStopTimer: ReturnType<typeof setTimeout>;

  const onScroll = () => {
    const currentY = Math.max(0, window.scrollY);
    const delta = currentY - lastScrollY;

    header?.setAttribute("data-scrolled", currentY > 24 ? "true" : "false");

    if (currentY > 160 && delta > 12) {
      header?.setAttribute("data-hidden", "true");
    } else if (delta < -4 || currentY <= 160) {
      header?.setAttribute("data-hidden", "false");
    }

    lastScrollY = currentY;

    clearTimeout(scrollStopTimer);
    scrollStopTimer = setTimeout(() => header?.setAttribute("data-hidden", "false"), 250);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setHeaderHeightVar = () => {
    if (!header) return;
    document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
  };
  setHeaderHeightVar();
  if (header) new ResizeObserver(setHeaderHeightVar).observe(header);
  window.addEventListener("resize", setHeaderHeightVar, { passive: true });

  document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((button) => {
    button.addEventListener("pointermove", (event) => {
      const rect = button.getBoundingClientRect();
      const x = (event.clientX - rect.left - rect.width / 2) * 0.35;
      const y = (event.clientY - rect.top - rect.height / 2) * 0.35;
      button.style.setProperty("--magnetic-x", `${x}px`);
      button.style.setProperty("--magnetic-y", `${y}px`);
    });
    button.addEventListener("pointerleave", () => {
      button.style.setProperty("--magnetic-x", "0px");
      button.style.setProperty("--magnetic-y", "0px");
    });
  });

  const mobileNav = document.getElementById("mobile-nav");
  const openBtn = document.getElementById("mobile-nav-toggle");
  const closeBtn = document.getElementById("mobile-nav-close");
  const links = document.querySelectorAll(".mobile-nav-link");

  const openNav = () => {
    mobileNav?.classList.remove("hidden");
    mobileNav?.classList.add("flex");
    openBtn?.setAttribute("aria-expanded", "true");
  };
  const closeNav = () => {
    mobileNav?.classList.add("hidden");
    mobileNav?.classList.remove("flex");
    openBtn?.setAttribute("aria-expanded", "false");
  };

  openBtn?.addEventListener("click", openNav);
  closeBtn?.addEventListener("click", closeNav);
  links.forEach((link) => link.addEventListener("click", closeNav));
</script>

<style is:global>
  [data-magnetic] {
    --magnetic-x: 0px;
    --magnetic-y: 0px;
    transform: translate3d(var(--magnetic-x), var(--magnetic-y), 0);
    transition: transform 180ms ease, color 180ms ease, background-color 180ms ease, border-color 180ms ease;
    will-change: transform;
  }

  [data-magnetic]:active,
  [data-glare]:active {
    transform: scale(0.96) translate3d(var(--magnetic-x, 0px), var(--magnetic-y, 0px), 0);
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .header-phone__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    border: 1px solid rgba(244, 241, 234, 0.24);
    border-radius: 50%;
  }

  [data-glare] {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  [data-glare]:hover {
    transform: scale(1.02);
  }

  .glare-sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    width: 50px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    transform: translateX(-150%) skewX(-20deg);
  }

  [data-glare]:hover .glare-sweep {
    animation: glare-sweep 850ms ease-in-out infinite;
    animation-delay: 150ms;
  }

  @keyframes glare-sweep {
    from { transform: translateX(-150%) skewX(-20deg); }
    to { transform: translateX(650%) skewX(-20deg); }
  }

  [data-glare] > *:not(.glare-sweep) {
    position: relative;
    z-index: 2;
  }
</style>
