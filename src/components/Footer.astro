---
import Logo from "./Logo.astro";
import { contact } from "../data/site";
---

<footer class="bg-ink text-cream px-5 sm:px-8 lg:px-20 pt-18 sm:pt-24 lg:pt-30 pb-12">
  <div class="max-w-7xl mx-auto grid gap-12" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
    <div class="flex flex-col gap-3">
      <span class="text-[13px] uppercase tracking-[0.18em] text-line">Follow us</span>
      <div class="flex items-center gap-3">
        <a href="https://www.facebook.com/" target="_blank" rel="noreferrer" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full border border-forest text-cream transition hover:border-brass hover:text-brass"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M14 8h3V4h-3c-3.31 0-5 1.69-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9c0-.66.34-1 1-1Z"></path></svg></a>
        <a href="https://www.instagram.com/" target="_blank" rel="noreferrer" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full border border-forest text-cream transition hover:border-brass hover:text-brass"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"></circle></svg></a>
      </div>
    </div>
    <div>
      <div class="mb-4.5">
        <Logo class="h-10" stroke="#F4F1EA" textColor="#F4F1EA" subTextColor="#F4F1EA" />
      </div>
      <p class="text-[15px] text-line max-w-[24em] m-0">Immaculate homes, handled quietly.</p>
    </div>
    <div class="text-[15px] text-line flex flex-col gap-1.5">
      <span>Villa Home Detail</span>
      <span>ADDRESS_TBD</span>
      <span>Austin, TX</span>
      <a href={contact.phoneHref} class="text-cream no-underline hover:text-brass">{contact.phone}</a>
    </div>
    <div class="text-[15px] text-line flex flex-col gap-1.5">
      <span>Monday–Saturday</span>
      <span>8:00am – 6:00pm</span>
    </div>
    <div>
      <a href="#pricing" class="inline-block bg-forest text-cream no-underline px-6.5 py-3.5 text-sm tracking-wide rounded-sm">
        Get your free quote
      </a>
    </div>
  </div>
  <p class="max-w-7xl mx-auto mt-14 pt-6 border-t border-forest text-[13px] text-line">
    © 2026 Villa Home Detail. Austin, Texas.
  </p>
</footer>
