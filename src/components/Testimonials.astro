---
import { testimonials } from "../data/site";
---

<section data-reveal class="bg-section-tint">
 <div class="px-5 sm:px-8 lg:px-20 py-18 sm:py-24 lg:py-30 max-w-7xl mx-auto">
  <h2 class="font-serif font-serif-opt font-medium text-[clamp(1.8rem,3.5vw,2.6rem)] tracking-[-0.01em] m-0 mb-14">
    What clients say
  </h2>
  <div class="grid gap-12" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
    {testimonials.map((t) => (
      <div>
        <p class="font-serif font-serif-opt italic text-[1.15rem] leading-relaxed m-0 mb-5">
          "{t.quote}"
        </p>
        <span class="text-sm text-ink">{t.name}</span>
      </div>
    ))}
  </div>
 </div>
</section>
