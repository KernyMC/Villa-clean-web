---
import { getSiteImages, urlFor } from "../lib/sanity";
import { contact } from "../data/site";

const RING_COUNT = 16;

const fallbackPhotos = [
  { label: "Care team arriving with supplies" },
  { label: "Kitchen deep clean — countertops and backsplash" },
  { label: "Living room — dusted, vacuumed, and staged" },
  { label: "Limestone hallway, soft morning light" },
  { label: "Primary bathroom — glass and grout polished" },
  { label: "White oak floors, freshly cleaned" },
  { label: "Founder on-site for a walkthrough" },
];

const siteImages = await getSiteImages();

const photos =
  siteImages?.heroSlides && siteImages.heroSlides.length > 0
    ? siteImages.heroSlides.map((slide) => ({
        label: slide.image?.alt || slide.label,
        imageUrl: slide.image?.asset
          ? urlFor(slide.image).width(380).height(507).fit("crop").auto("format").url()
          : undefined,
      }))
    : fallbackPhotos;

// Full 360° ring so the rotation never shows a gap — cycle the available
// photos to fill all RING_COUNT slots even if fewer were uploaded in Sanity.
const ring = Array.from({ length: RING_COUNT }, (_, i) => {
  const photo = photos[i % photos.length];
  const isTopThree = i === 0 || i === 1 || i === RING_COUNT - 1;
  return { ...photo, i, priority: isTopThree };
});
---

<section
  id="top"
  data-reveal
  class="hero relative overflow-hidden bg-ink"
>
  <div class="hero__fade" aria-hidden="true"></div>

  <div class="hero__ring" aria-hidden="true">
    {ring.map((card) => (
      <figure class="hero__card" style={`--i:${card.i}`}>
        {card.imageUrl ? (
          <img
            src={card.imageUrl}
            alt=""
            width="190"
            height="253"
            loading={card.priority ? "eager" : "lazy"}
            fetchpriority={card.priority ? "high" : "auto"}
          />
        ) : (
          <span class="hero__card-fallback">{card.label}</span>
        )}
      </figure>
    ))}
  </div>

  <div class="hero__dome" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 class="hero__title">Premium House Cleaning for Austin's Westside Homes</h1>
    <p class="hero__lede">
      A discreet, background-checked team maintains your home to the same exacting standard, every
      visit — so it never becomes something you have to think about.
    </p>
    <div class="hero__cta-group">
      <a href="#pricing" class="hero__cta hero__cta--primary">
        <span class="hero__cta-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 22.76 22.76">
            <path d="M22.34,1A14.67,14.67,0,0,1,12,5.3,14.6,14.6,0,0,1,6.08,4.06,14.68,14.68,0,0,1,1.59,1" transform="translate(-0.29 -0.29)" fill="none" stroke="currentColor" stroke-width="2"></path>
            <path d="M22.34,1a14.67,14.67,0,0,0,0,20.75" transform="translate(-0.29 -0.29)" fill="none" stroke="currentColor" stroke-width="2"></path>
            <path d="M22.34,1,1,22.34" transform="translate(-0.29 -0.29)" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </span>
        Get your free quote in 60 seconds
      </a>
      <a href={contact.phoneHref} class="hero__cta hero__cta--secondary">
        <span class="hero__cta-icon hero__cta-icon--secondary" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"></path>
          </svg>
        </span>
        {contact.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h, 96px) + 8px);
    isolation: isolate;
    /* Shared by the ring and the dome so they stay concentric — the dome
       is a sibling of the ring, not a child, so these have to live on the
       common ancestor to be visible to both. */
    --count: 16;
    --ring-radius: 580px;
    --ring-offset: 267px;
    --card-lift: 65px;
    --card-w: 320px;
    --card-h: 333px;
  }

  /* ---------- ring ---------- */
  .hero__ring {
    position: absolute;
    left: 50%;
    top: calc(50% + var(--header-h, 96px) + var(--ring-offset));
    width: 0;
    height: 0;
    z-index: 1;
    animation: ring-spin 70s linear infinite;
    will-change: transform;
  }

  @keyframes ring-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__card {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--card-w);
    height: var(--card-h);
    margin: calc(var(--card-h) / -2) 0 0 calc(var(--card-w) / -2);
    --angle: calc(var(--i) * (360deg / var(--count)));
    transform: translateY(calc(var(--card-lift) * -1)) rotate(var(--angle)) translateY(calc(var(--ring-radius) * -1));
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(244, 241, 234, 0.14);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
  }

  .hero__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__card-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 10px;
    text-align: center;
    background: rgba(244, 241, 234, 0.06);
    color: rgba(244, 241, 234, 0.6);
    font-family: ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  /* ---------- fade ---------- */
  .hero__fade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to bottom, var(--color-ink) 0%, transparent 24%);
  }

  /* ---------- dome ---------- */
  /* Concentric with the ring — same center point, radius a touch smaller
     than --ring-radius — so its edge passes right through the cards
     instead of floating apart from them. */
  .hero__dome {
    position: absolute;
    left: 50%;
    top: calc(50% + var(--header-h, 96px) + var(--ring-offset));
    /* Card sits centered at radius --ring-radius, spanning ±(card-h/2)
       along its own axis. Mask exactly 35% of --card-h — expressed as a
       fraction of --card-h (not a fixed px gap) so this stays correct as
       --card-h changes across breakpoints, not just on desktop. */
    width: calc((var(--ring-radius) - var(--card-h) * 0.35) * 2);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: color-mix(in srgb, var(--color-ink) 62%, var(--color-forest) 38%);
    border: 1px solid rgba(244, 241, 234, 0.08);
    box-shadow: 0 -40px 90px rgba(0, 0, 0, 0.35);
    z-index: 2;
    pointer-events: none;
  }

  /* ---------- content ---------- */
  .hero__content {
    position: relative;
    z-index: 3;
    max-width: 42rem;
    margin: 260px auto 0;
    padding: 0 clamp(20px, 6vw, 48px);
    text-align: center;
  }

.hero__title {
    font-family: "Fraunces", serif;
    font-variation-settings: "SOFT" 60;
    font-weight: 500;
    color: var(--color-cream);
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }

  .hero__lede {
    color: rgba(244, 241, 234, 0.78);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    max-width: 46ch;
    margin: 0 auto 24px;
  }

  .hero__cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 16px 24px 16px 16px;
    font-size: 15px;
    letter-spacing: 0.02em;
    border-radius: 999px;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero__cta--primary {
    background: var(--color-brass);
    color: var(--color-ink);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--color-cream);
    border: 1.5px solid rgba(244, 241, 234, 0.35);
  }

  .hero__cta--secondary:hover {
    border-color: rgba(244, 241, 234, 0.6);
    background: rgba(244, 241, 234, 0.06);
  }

  .hero__cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-cream);
    font-size: 15px;
  }

  .hero__cta-icon--secondary {
    background: rgba(244, 241, 234, 0.12);
    color: var(--color-cream);
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }


  /* ---------- responsive ring ---------- */
  @media (min-width: 1440px) {
    .hero {
      --ring-radius: 680px;
    }
  }

  /* Tablet keeps the same ring+dome system as desktop, just smaller and
     raised further (only the shared vars on .hero change — never
     --ring-radius etc. on .hero__ring/.hero__dome directly — so the two
     stay concentric). Phone drops the ring entirely: at that width there's
     no room for cards beside centered copy without them colliding, so it's
     a flat, un-rotated row of cards in normal flow above the copy instead. */
  @media (max-width: 1023px) {
    .hero {
      align-items: flex-start;
    }
    .hero__content {
      position: static;
      transform: none;
    }
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .hero {
      --ring-radius: 750px;
      --ring-offset: 271px;
      --card-lift: 55px;
      --card-w: 280px;
      --card-h: 267px;
    }
    .hero__content {
      margin-top: 222px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      --ring-radius: 357px;
      --ring-offset: 23px;
      --card-lift: 26px;
      --card-w: 135px;
      --card-h: 127px;
    }
    .hero__content {
      margin-top: 144px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ring {
      animation: none;
    }
  }
</style>
