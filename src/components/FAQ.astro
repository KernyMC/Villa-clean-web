---
import { faqItems } from "../data/site";
---

<section id="faq" data-reveal class="bg-section-tint">
 <div class="px-5 sm:px-8 lg:px-20 py-18 sm:py-24 lg:py-30 max-w-6xl mx-auto">
  <div class="grid gap-14 lg:grid-cols-2 lg:gap-20 items-start">
    <div>
      <h2 class="font-serif font-serif-opt font-medium text-[clamp(1.8rem,3.5vw,2.6rem)] tracking-[-0.01em] m-0 mb-10">
        Frequently asked
      </h2>
      <div class="flex flex-col">
        {faqItems.map((f) => (
          <div class="faq-item border-t border-line">
            <button
              type="button"
              class="faq-toggle w-full text-left bg-none border-none py-5.5 flex justify-between items-center gap-4 cursor-pointer text-ink text-[17px] font-sans"
              aria-expanded="false"
            >
              <span>{f.question}</span>
              <span aria-hidden="true" class="faq-indicator text-brass text-lg flex-shrink-0">+</span>
            </button>
            <p class="faq-answer hidden m-0 mb-6 max-w-[38em] text-ink text-base">{f.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="lg:pt-1">
      <h2 class="font-serif font-serif-opt font-medium text-[clamp(1.8rem,3.5vw,2.6rem)] tracking-[-0.01em] m-0 mb-4">
        Still have a question?
      </h2>
      <p class="text-ink text-base m-0 mb-8 max-w-[36em]">
        Send us a note and we will get back to you within one business day.
      </p>

      <p id="contact-sent-message" class="hidden text-[15px] text-ink">
        Thanks — we will get back to you within one business day.
      </p>
      <p id="contact-error-message" class="hidden text-[15px] text-red-700"></p>

      <form id="contact-form" class="flex flex-col gap-4">
        <div>
          <label for="contact-name" class="block text-sm text-ink mb-1.5">Name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            placeholder="Your name"
            class="w-full border border-line bg-cream text-ink px-3.5 py-3 text-[15px] rounded-sm"
          />
        </div>
        <div>
          <label for="contact-email" class="block text-sm text-ink mb-1.5">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            placeholder="you@email.com"
            class="w-full border border-line bg-cream text-ink px-3.5 py-3 text-[15px] rounded-sm"
          />
        </div>
        <div>
          <label for="contact-message" class="block text-sm text-ink mb-1.5">Message</label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="4"
            placeholder="How can we help?"
            class="w-full border border-line bg-cream text-ink px-3.5 py-3 text-[15px] rounded-sm resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          data-morph
          class="self-start bg-forest text-cream border-none px-5.5 py-3 text-sm tracking-wide rounded-sm cursor-pointer mt-1 inline-flex items-center justify-center gap-2.5"
        >
          <span class="morph-icon" aria-hidden="true">
            <svg class="morph-send" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m22 2-7 20-4-9-9-4Z"></path>
              <path d="M22 2 11 13"></path>
            </svg>
            <svg class="morph-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          </span>
          Send message
        </button>
      </form>
    </div>
  </div>
 </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".faq-item").forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>(".faq-toggle")!;
    const answer = item.querySelector<HTMLParagraphElement>(".faq-answer")!;
    const indicator = item.querySelector<HTMLSpanElement>(".faq-indicator")!;

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      answer.classList.toggle("hidden", isOpen);
      indicator.textContent = isOpen ? "+" : "−";
    });
  });

  const contactForm = document.getElementById("contact-form") as HTMLFormElement;
  const contactSentMessage = document.getElementById("contact-sent-message")!;
  const contactErrorMessage = document.getElementById("contact-error-message")!;
  const contactSubmitBtn = contactForm.querySelector<HTMLButtonElement>("button[type=submit]")!;

  contactSubmitBtn.addEventListener("pointerenter", () => contactSubmitBtn.setAttribute("data-hovered", "true"));
  contactSubmitBtn.addEventListener("pointerleave", () => contactSubmitBtn.setAttribute("data-hovered", "false"));

  contactForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    contactErrorMessage.classList.add("hidden");
    contactSubmitBtn.disabled = true;

    const data = Object.fromEntries(new FormData(contactForm).entries());

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (result.ok) {
        contactForm.classList.add("hidden");
        contactSentMessage.classList.remove("hidden");
      } else {
        contactErrorMessage.textContent = result.error || "Something went wrong. Please try again.";
        contactErrorMessage.classList.remove("hidden");
      }
    } catch {
      contactErrorMessage.textContent = "Something went wrong. Please try again.";
      contactErrorMessage.classList.remove("hidden");
    } finally {
      contactSubmitBtn.disabled = false;
    }
  });
</script>

<style>
  [data-morph] {
    transition: transform 180ms ease, opacity 180ms ease;
  }

  [data-morph]:hover {
    transform: scale(1.02);
  }

  [data-morph]:active {
    transform: scale(0.96);
  }

  .morph-icon {
    position: relative;
    display: inline-flex;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .morph-icon svg {
    position: absolute;
    inset: 0;
    width: 16px;
    height: 16px;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease;
  }

  .morph-check {
    opacity: 0;
    transform: scale(0.5);
  }

  [data-morph][data-hovered="true"] .morph-send {
    opacity: 0;
    transform: scale(0.5);
  }

  [data-morph][data-hovered="true"] .morph-check {
    opacity: 1;
    transform: scale(1);
  }
</style>
