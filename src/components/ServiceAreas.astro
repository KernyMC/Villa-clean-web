---
import { areas } from "../data/site";

const areaImages = [
  "https://cdn.sanity.io/images/c6i8g8qm/production/8635cccf5b693d05bf89c1fb3403582007d19f36-1350x753.avif",
  "https://cdn.sanity.io/images/c6i8g8qm/production/974c7b7f0630ddce7891c37be9d843dab328ba2d-1350x753.avif",
  "https://cdn.sanity.io/images/c6i8g8qm/production/b6376f141a8840c50157f30f556daf000253577f-1350x753.avif",
];
---

<section id="areas" data-reveal class="bg-section-tint">
  <div class="mx-auto max-w-7xl px-5 py-18 sm:px-8 sm:py-24 lg:px-20 lg:py-30">
    <div class="mb-10 flex items-end justify-between gap-6 sm:mb-12">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-brass">Where we work</p>
        <h2 class="m-0 font-serif font-serif-opt text-[clamp(1.8rem,3.5vw,2.6rem)] font-medium tracking-[-0.01em]">
          Service areas
        </h2>
      </div>
      <p class="m-0 hidden max-w-xs text-right text-sm leading-relaxed text-forest/65 sm:block">
        Thoughtful home care for Austin's most distinctive neighborhoods.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2">
      {areas.map((area, index) => (
        <div
          class:list={[
            "group relative isolate min-h-[280px] overflow-hidden rounded-[1.5rem] bg-forest",
            index === 0 && "md:col-span-2 lg:col-span-2 lg:row-span-2 lg:min-h-[560px]",
            index > 0 && "lg:min-h-[270px]",
            index === 0 && "rounded-[2rem] rounded-br-[7rem]",
            index === 1 && "rounded-[5rem] rounded-tr-[2rem]",
            index === 2 && "rounded-[2rem] rounded-tl-[5rem]",
          ]}
        >
          <img
            src={areaImages[index]}
            alt={`House cleaning in ${area.name}`}
            class="absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 z-10 p-6 sm:p-7" style="background: linear-gradient(0deg, rgba(28,38,32,0.78) 0%, rgba(28,38,32,0.32) 55%, transparent 100%);">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-cream/70">
              0{index + 1} · Austin
            </span>
            <h3 class="m-0 max-w-md font-serif font-serif-opt text-[clamp(1.4rem,3vw,2.2rem)] font-medium leading-tight text-cream">
              {area.name}
            </h3>
            <span class="mt-4 inline-flex translate-y-2 items-center gap-2 text-sm font-medium text-cream opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
              Explore area
              <span aria-hidden="true" class="text-lg leading-none">↗</span>
            </span>
          </div>
        </div>
      ))}
    </div>
    <a href="#faq" data-text-reveal class="mt-6 inline-flex items-center justify-center gap-2.5 rounded-full border border-forest/20 bg-forest/[0.04] px-6 py-3 text-sm font-medium text-forest transition-colors duration-200 hover:bg-forest/[0.08]">
      <span class="text-reveal-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </span>
      <span class="text-reveal-label"><span>And more areas of Texas</span><span>Get your free quote</span></span>
    </a>
  </div>
</section>

<style>
  [data-text-reveal] {
    transform: scale(1);
    transition: transform 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  [data-text-reveal]:hover {
    transform: scale(1.02);
  }

  [data-text-reveal]:active {
    transform: scale(0.96);
  }

  .text-reveal-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .text-reveal-icon svg {
    width: 16px;
    height: 16px;
  }

  [data-text-reveal]:hover .text-reveal-icon {
    transform: rotate(45deg);
  }

  .text-reveal-label {
    display: flex;
    height: 18px;
    overflow: hidden;
    flex-direction: column;
  }

  .text-reveal-label > span {
    display: block;
    height: 18px;
    line-height: 18px;
    white-space: nowrap;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-text-reveal]:hover .text-reveal-label > span {
    transform: translateY(-18px);
  }
</style>
