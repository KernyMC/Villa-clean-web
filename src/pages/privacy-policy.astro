---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contact } from "../data/site";

const lastUpdated = "August 18, 2026";
---

<Layout
  title="Privacy Policy — Villa Home Detail"
  description="How Villa Home Detail collects, uses, and protects the information you share through our website and contact form."
>
  <Header />
  <main class="bg-cream text-ink">
    <div class="px-5 sm:px-8 lg:px-20 pt-32 sm:pt-36 lg:pt-40 pb-20 max-w-3xl mx-auto">
      <h1 class="font-serif font-serif-opt font-medium text-[clamp(1.8rem,3.5vw,2.6rem)] tracking-[-0.01em] m-0 mb-2">
        Privacy Policy
      </h1>
      <p class="text-sm text-ink/60 mb-12">Last updated: {lastUpdated}</p>

      <div class="flex flex-col gap-9 text-[15px] leading-relaxed">
        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Who we are</h2>
          <p class="m-0">
            Villa Home Detail ("we," "us," "our") provides residential house cleaning services in West Lake
            Hills, Tarrytown, and Barton Creek, Austin, TX. This policy explains what information we collect
            through <a href="/" class="text-forest underline underline-offset-2 hover:text-brass">villahomedetail.com</a>,
            why we collect it, and how we handle it.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Information we collect</h2>
          <p class="m-0 mb-3">When you use our contact form, we collect only what you submit:</p>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 m-0">
            <li>Name</li>
            <li>Email address</li>
            <li>Phone number</li>
            <li>The message you write</li>
          </ul>
          <p class="mt-3 mb-0">
            We do not use analytics or advertising cookies on this site. The only data we store in your
            browser is a language preference (English/Spanish) and whether you've dismissed our cookie
            notice — both stored locally on your device, not on our servers, and used purely to remember
            your preference on return visits.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">How we use your information</h2>
          <p class="m-0 mb-3">We use the information you submit through the contact form only to:</p>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 m-0">
            <li>Respond to your inquiry and provide a quote</li>
            <li>Schedule a walkthrough or cleaning visit, if you become a client</li>
            <li>Follow up on the specific request you sent us</li>
          </ul>
          <p class="mt-3 mb-0">
            We do not sell, rent, or share your information with third parties for marketing purposes.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">How your information is handled</h2>
          <p class="m-0">
            Contact form submissions are sent directly to our business email over an encrypted connection.
            We keep this correspondence only as long as needed to respond to you and, if you become a
            client, to maintain a record of that relationship. We do not maintain a public-facing database
            of submissions.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Your rights</h2>
          <p class="m-0">
            You can ask us to access, correct, or delete the information you've sent us at any time by
            calling <a href={contact.phoneHref} class="text-forest underline underline-offset-2 hover:text-brass">{contact.phone}</a>
            or replying to any email correspondence with us. We'll respond within a reasonable time.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Changes to this policy</h2>
          <p class="m-0">
            If we change how we collect or use information, we'll update this page and revise the date
            above.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Contact us</h2>
          <p class="m-0">
            Questions about this policy? Call <a href={contact.phoneHref} class="text-forest underline underline-offset-2 hover:text-brass">{contact.phone}</a>
            or use the <a href="/#faq" class="text-forest underline underline-offset-2 hover:text-brass">contact form</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
