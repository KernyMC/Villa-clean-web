---
import Layout from "../layouts/Layout.astro";
import { contact } from "../data/site";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import Services from "../components/Services.astro";
// import PricingCalculator from "../components/PricingCalculator.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Checklist from "../components/Checklist.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
// import Testimonials from "../components/Testimonials.astro";
// import GuaranteeBanner from "../components/GuaranteeBanner.astro";
import ServiceAreas from "../components/ServiceAreas.astro";
import About from "../components/About.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";

const whatsappHref = `https://wa.me/${contact.phoneHref.replace(/\D/g, "")}`;
---

<Layout>
  <Header />
  <a href={whatsappHref} target="_blank" rel="noreferrer" aria-label="Chat with Villa Home Detail on WhatsApp" class="fixed bottom-5 right-5 z-[90] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_12px_30px_rgba(37,211,102,0.3)] transition duration-300 hover:scale-110 hover:shadow-[0_16px_36px_rgba(37,211,102,0.42)]">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor"><path d="M20.52 3.48A11.83 11.83 0 0 0 12.08 0C5.55 0 .23 5.31.23 11.84c0 2.09.55 4.13 1.59 5.93L.13 24l6.38-1.67a11.84 11.84 0 0 0 5.57 1.41h.01c6.53 0 11.84-5.31 11.84-11.84 0-3.17-1.23-6.15-3.41-8.42Zm-8.44 18.22h-.01a9.84 9.84 0 0 1-5.02-1.37l-.36-.21-3.79.99 1.01-3.69-.23-.38a9.84 9.84 0 1 1 8.4 4.66Zm5.4-7.38c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.79-1.68-2.09-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path></svg>
  </a>
  <nav aria-label="Social links" class="fixed left-0 top-1/2 z-[80] hidden -translate-y-1/2 flex-col overflow-hidden rounded-r-xl border border-line bg-cream/90 shadow-[0_10px_30px_rgba(0,0,0,0.12)] backdrop-blur-sm lg:flex">
    <a href="https://www.facebook.com/" target="_blank" rel="noreferrer" aria-label="Facebook" class="flex h-12 w-12 items-center justify-center text-forest transition hover:bg-forest hover:text-cream"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M14 8h3V4h-3c-3.31 0-5 1.69-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9c0-.66.34-1 1-1Z"></path></svg></a>
    <a href="https://www.instagram.com/" target="_blank" rel="noreferrer" aria-label="Instagram" class="flex h-12 w-12 items-center justify-center border-t border-line text-forest transition hover:bg-forest hover:text-cream"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"></circle></svg></a>
  </nav>
  <main>
    <Hero />
    <TrustBar />
    <Services />
    {/* <PricingCalculator /> */}
    <HowItWorks />
    <Checklist />
    <BeforeAfter />
    {/* <Testimonials /> */}
    {/* <GuaranteeBanner /> */}
    <ServiceAreas />
    <About />
    <FAQ />
  </main>
  <Footer />
</Layout>
