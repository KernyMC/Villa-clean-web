---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contact } from "../data/site";

const lastUpdated = "August 18, 2026";
---

<Layout
  title="Terms & Conditions — Villa Home Detail"
  description="The terms that govern your use of villahomedetail.com and requests submitted through our contact form."
>
  <Header />
  <main class="bg-cream text-ink">
    <div class="px-5 sm:px-8 lg:px-20 pt-32 sm:pt-36 lg:pt-40 pb-20 max-w-3xl mx-auto">
      <h1 class="font-serif font-serif-opt font-medium text-[clamp(1.8rem,3.5vw,2.6rem)] tracking-[-0.01em] m-0 mb-2">
        Terms &amp; Conditions
      </h1>
      <p class="text-sm text-ink/60 mb-12">Last updated: {lastUpdated}</p>

      <div class="flex flex-col gap-9 text-[15px] leading-relaxed">
        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Agreement to terms</h2>
          <p class="m-0">
            By using <a href="/" class="text-forest underline underline-offset-2 hover:text-brass">villahomedetail.com</a>
            or submitting our contact form, you agree to these terms. Villa Home Detail provides residential
            cleaning services in West Lake Hills, Tarrytown, and Barton Creek, Austin, TX.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Estimates and quotes</h2>
          <p class="m-0">
            Any price range shown on this site is an estimate only. Final pricing is confirmed after an
            in-person walkthrough of your home and may vary based on its condition, size, and the scope of
            work requested. Submitting the contact form does not create a binding service agreement — it's
            a request for us to follow up with you.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Using this website</h2>
          <p class="m-0 mb-3">When using this site, you agree not to:</p>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 m-0">
            <li>Submit false or misleading information through the contact form</li>
            <li>Attempt to disrupt, overload, or gain unauthorized access to the site or its systems</li>
            <li>Copy or reuse the site's content, photography, or branding without permission</li>
          </ul>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Intellectual property</h2>
          <p class="m-0">
            The text, photography, and design on this site belong to Villa Home Detail unless otherwise
            noted, and may not be reproduced without our written permission.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">No warranty</h2>
          <p class="m-0">
            This site and its content are provided "as is." While we work to keep information accurate, we
            don't guarantee the site will be error-free or uninterrupted.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Limitation of liability</h2>
          <p class="m-0">
            To the extent permitted by law, Villa Home Detail is not liable for indirect or incidental
            damages arising from your use of this website. This does not limit any liability related to
            cleaning services performed in your home, which are governed separately by the terms you agree
            to when booking service.
          </p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Governing law</h2>
          <p class="m-0">These terms are governed by the laws of the State of Texas.</p>
        </section>

        <section>
          <h2 class="font-serif font-serif-opt font-medium text-xl mb-3">Contact us</h2>
          <p class="m-0">
            Questions about these terms? Call <a href={contact.phoneHref} class="text-forest underline underline-offset-2 hover:text-brass">{contact.phone}</a>
            or use the <a href="/#faq" class="text-forest underline underline-offset-2 hover:text-brass">contact form</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
