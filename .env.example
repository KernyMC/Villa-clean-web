# Copy this file to .env and fill in real values for local development.
# In production (Dokploy), these are set directly in the application's
# environment variables — never committed anywhere.

# SMTP for the FAQ contact form (src/pages/api/contact.ts).
# Hostinger/Titan example shown — adjust host/port for your provider.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Where contact form submissions are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=
